# Adresse, unter der die Seite öffentlich erreichbar ist.
#
# Ohne Angabe gilt die Vercel-Adresse aus lib/site.ts. Sobald eine eigene
# Domain steht, hier eintragen — kanonische Adressen, Sitemap, robots.txt,
# Vorschaubilder und strukturierte Daten ziehen automatisch nach.
#
# Ohne abschließenden Schrägstrich, mit https://
NEXT_PUBLIC_SITE_URL=

# Zugangsdaten der eBay-Anwendung (Produktion, nicht Sandbox).
#
# Zu finden im eBay Developers Program unter „Application Keys":
#   EBAY_CLIENT_ID     entspricht dort der App ID (Client ID)
#   EBAY_CLIENT_SECRET entspricht dort der Cert ID (Client Secret)
#
# Nur auf dem Server lesbar — bewusst ohne NEXT_PUBLIC_-Vorsatz, damit die
# Werte nicht in den Browser gelangen. Fehlen sie, antwortet die Route
# /api/kategorie mit 503 und der Rechner funktioniert unverändert weiter.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Marktplatz, für den Angebote gesucht werden. Ohne Angabe EBAY_DE.
EBAY_MARKETPLACE_ID=EBAY_DE
