{
  "manifest_version": 3,
  "name": "Gebührenkompass",
  "version": "1.0",
  "description": "Gebühren, Gewinn und Marge für eBay und Kaufland — direkt von der Produktseite aus.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting"]
}
